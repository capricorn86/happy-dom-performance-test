{
    "name": "happy-dom-jsdom-benchmark",
    "version": "2.0.0",
    "description": "Comprehensive performance benchmarks comparing Happy DOM and JSDOM",
    "type": "module",
    "main": "lib/benchmark.ts",
    "scripts": {
        "bench": "node lib/benchmark.ts",
        "bench:happy-dom": "node lib/benchmark.ts --library=happy-dom",
        "bench:jsdom": "node lib/benchmark.ts --library=jsdom",
        "bench:local": "node lib/benchmark.ts --use-local",
        "bench:compare": "node lib/benchmark.ts --compare",
        "typecheck": "tsc --noEmit",
        "test": "node lib/benchmark.ts"
    },
    "engines": {
        "node": ">=24.11.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/capricorn86/happy-dom-performance-test.git"
    },
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/capricorn86/happy-dom-performance-test/issues"
    },
    "homepage": "https://github.com/capricorn86/happy-dom-performance-test#readme",
    "dependencies": {
        "happy-dom": "^15.7.4",
        "jsdom": "^25.0.1"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.9.0",
        "typescript": "^5.6.3"
    }
}
